   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "uptime_seconds",
     "legendFormat": "{{service}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
